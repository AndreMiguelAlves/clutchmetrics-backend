{
  "info": {
    "name": "ClutchMetrics - KDA Match Data (October 2026)",
    "description": "20 example matches (10 League of Legends, 10 Valorant) for KDA graphs. Use Run on one folder at a time. Uses the existing POST /api/matches backend API. First set collection variables: accessToken (JWT), valorantAccountId (from GET /api/game-accounts). LoL account ID is confirmed 1. DO NOT run repeatedly; externalMatchIds are fixed and should be unique.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "lolAccountId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "valorantAccountId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0 - Check account IDs (run first)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/game-accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "game-accounts"
          ]
        },
        "description": "Find the Valorant player game account ID in the response and set collection variable valorantAccountId."
      }
    },
    {
      "name": "1 - League of Legends (10 matches)",
